# Copy to .env. Never commit .env. Use a FRESH testnet-only wallet.

# mock = everything runs in memory on your laptop (no chain, no tokens needed)
# live = QoreChain testnet (needs the rollup stake, see README)
Q402_MODE=mock

Q402_CHAIN_ID=qorechain-diana
Q402_ROLLUP_ID=q402-pay

# Ports
Q402_DEVNET_PORT=8402
Q402_PROVIDER_PORT=8403

# How long a batch can be challenged before it finalizes (mock mode, seconds)
Q402_MOCK_CHALLENGE_WINDOW_SEC=20
# How often the operator posts a batch (ms)
Q402_BATCH_INTERVAL_MS=4000

# ---- live mode only ----
# Operator (rollup creator, batch submitter, poster) testnet account.
QORE_MNEMONIC=
# Gas price used for "auto" fees
QORE_GAS_PRICE=0.1uqor
